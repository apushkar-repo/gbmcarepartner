# Copy this file to .env and fill in values locally. Never commit .env.
LLAMA_CLOUD_API_KEY=

# Optional semantic retrieval. BM25 remains available when these are blank.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the dimension of the Pinecone index. text-embedding-3 models support shortened embeddings.
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_ANSWER_MODEL=gpt-4o-mini
OPENAI_PREPARATION_MODEL=gpt-4o-mini
OPENAI_PREPARATION_VERIFIER_MODEL=gpt-4.1-mini
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
# PINECONE_INDEX can be used instead of PINECONE_INDEX_HOST.
PINECONE_INDEX=

# Development-only HMAC secret for signed mock delivery callbacks.
MOCK_PROVIDER_WEBHOOK_SECRET=

# Optional LangSmith tracing. Inputs and outputs are forcibly hidden by the app.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=carebridge-development
# Choose the approved regional endpoint for the target deployment.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Optional semantic grading for development evaluation runs.
# Deterministic retrieval, citation, and abstention checks do not use this setting.
RAGAS_EVALUATOR_MODEL=gpt-4o-mini
